# GitHub auto-deploy configuration
# Copy: cp deploy/github.env.example deploy/github.env

# Your GitHub repository (HTTPS or SSH)
GITHUB_REPO=https://github.com/YOUR_USER/the-agentic-ai-company.git
# GITHUB_REPO=git@github.com:YOUR_USER/the-agentic-ai-company.git

# Branch to track and deploy
DEPLOY_BRANCH=main

# Git remote name
GIT_REMOTE=origin

# Webhook secret (Settings → Webhooks → secret) — for instant deploy on push
GITHUB_WEBHOOK_SECRET=

# Webhook listen port (when running: ./scripts/github-sync.sh webhook)
WEBHOOK_PORT=9000

# Poll interval seconds (watch mode)
POLL_INTERVAL=60
